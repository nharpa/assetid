<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "AssetID" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if logged_in? %>
      <nav class="navbar">
        <%= link_to "AssetID", root_path, class: "navbar-brand" %>
        <ul class="navbar-nav">
          <li><%= link_to "Assets",            assets_path %></li>
          <li><%= link_to "Locations",          locations_path %></li>
          <li><%= link_to "Asset Classes",      asset_classes_path %></li>
          <li><%= link_to "Characteristics",    characteristics_path %></li>
          <% if current_user.admin? %>
            <li><%= link_to "Users", users_path %></li>
          <% end %>
        </ul>
        <div class="navbar-user">
          <span><%= current_user.name %> &middot; <%= current_user.role %></span>
          <%= button_to "Log out", logout_path, method: :delete %>
        </div>
      </nav>
    <% end %>

    <div class="container">
      <% if flash[:notice] %>
        <div class="flash flash-notice"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="flash flash-alert"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
