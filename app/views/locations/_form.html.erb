<% if location.errors.any? %>
  <div class="flash flash-alert">
    <strong>Please fix the following errors:</strong>
    <ul>
      <% location.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="form-group">
  <%= f.label :plant_name, "Plant Name" %>
  <%= f.text_field :plant_name, autofocus: true %>
</div>

<div class="form-row">
  <div class="form-group">
    <%= f.label :address_line_1, "Address Line 1" %>
    <%= f.text_field :address_line_1 %>
  </div>
  <div class="form-group">
    <%= f.label :address_line_2, "Address Line 2" %>
    <%= f.text_field :address_line_2 %>
  </div>
</div>

<div class="form-row">
  <div class="form-group">
    <%= f.label :suburb %>
    <%= f.text_field :suburb %>
  </div>
  <div class="form-group">
    <%= f.label :state %>
    <%= f.text_field :state %>
  </div>
</div>

<div class="form-group">
  <%= f.label :notes %>
  <%= f.text_area :notes %>
</div>

<div class="form-actions">
  <%= f.submit location.persisted? ? "Update Location" : "Create Location", class: "btn btn-primary" %>
  <%= link_to "Cancel", locations_path, class: "btn btn-secondary" %>
</div>
