<%# View: Locations#index — Lists all plant locations with asset counts %>
<% content_for :title, "Locations – AssetID" %>

<div class="page-header">
  <h1 class="page-title">Locations</h1>
  <%= link_to "New Location", new_location_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <% if @locations.any? %>
    <table>
      <thead>
        <tr>
          <th>Plant Name</th>
          <th>Suburb</th>
          <th>State</th>
          <th>Assets</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @locations.each do |loc| %>
          <tr>
            <td><%= link_to loc.plant_name, location_path(loc) %></td>
            <td><%= loc.suburb %></td>
            <td><%= loc.state %></td>
            <td><%= loc.assets.count %></td>
            <td>
              <div class="actions">
                <%= link_to "Edit",   edit_location_path(loc),  class: "btn btn-secondary btn-sm" %>
                <%= button_to "Delete", location_path(loc), method: :delete,
                      data: { turbo_confirm: "Delete #{loc.plant_name}?" },
                      class: "btn btn-danger btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">No locations found. <%= link_to "Add one", new_location_path %>.</div>
  <% end %>
</div>
