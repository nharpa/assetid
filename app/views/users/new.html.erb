<%# View: Users#new — Form to create a new user %>
<% content_for :title, "New User – AssetID" %>
<div class="page-header">
  <h1 class="page-title">New User</h1>
</div>
<div class="card">
  <div class="card-body">
    <%= form_with model: @user do |f| %>
      <%= render "form", f: f, user: @user %>
    <% end %>
  </div>
</div>
