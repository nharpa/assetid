<%# View: Users#edit — Form to edit an existing user %>
<% content_for :title, "Edit #{@user.name} – AssetID" %>
<div class="page-header">
  <h1 class="page-title">Edit User</h1>
  <%= link_to "Cancel", users_path, class: "btn btn-secondary" %>
</div>
<div class="card">
  <div class="card-body">
    <%= form_with model: @user do |f| %>
      <%= render "form", f: f, user: @user %>
    <% end %>
  </div>
</div>
