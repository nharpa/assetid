<% content_for :title, "#{@asset_class.name} – AssetID" %>

<div class="page-header">
  <h1 class="page-title"><%= @asset_class.name %></h1>
  <div class="actions">
    <%= link_to "Edit",  edit_asset_class_path(@asset_class), class: "btn btn-secondary" %>
    <%= link_to "Back",  asset_classes_path,                 class: "btn btn-secondary" %>
  </div>
</div>

<% if @asset_class.description.present? %>
  <div class="card">
    <div class="card-body"><%= @asset_class.description %></div>
  </div>
<% end %>

<div class="card">
  <div class="card-header">
    <h2>Characteristics (<%= @asset_class_characteristics.count %>)</h2>
  </div>

  <% if @asset_class_characteristics.any? %>
    <table>
      <thead>
        <tr>
          <th>Order</th>
          <th>Characteristic</th>
          <th>Type</th>
          <th>Unit</th>
          <th>Required</th>
          <% if current_user.admin? %><th></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @asset_class_characteristics.each do |acc| %>
          <tr>
            <td><%= acc.display_order %></td>
            <td><%= link_to acc.characteristic.name, characteristic_path(acc.characteristic) %></td>
            <td><%= data_type_badge(acc.characteristic.data_type) %></td>
            <td><%= acc.characteristic.unit.presence || "—" %></td>
            <td><%= acc.required? ? "Yes" : "No" %></td>
            <% if current_user.admin? %>
              <td>
                <%= button_to "Remove",
                      asset_class_asset_class_characteristic_path(@asset_class, acc),
                      method: :delete,
                      data: { turbo_confirm: "Remove this characteristic?" },
                      class: "btn btn-danger btn-sm" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">No characteristics assigned to this asset class.</div>
  <% end %>

  <% if current_user.admin? && @available_characteristics.any? %>
    <div class="card-body" style="border-top: 1px solid var(--border);">
      <div class="section-title">Add Characteristic</div>
      <%= form_with model: [@asset_class, @new_acc], local: true do |f| %>
        <div class="inline-form">
          <div class="form-group">
            <%= f.label :characteristic_id, "Characteristic" %>
            <%= f.select :characteristic_id,
                  @available_characteristics.map { |c| [c.name, c.id] },
                  { include_blank: "Select..." } %>
          </div>
          <div class="form-group">
            <%= f.label :display_order, "Display Order" %>
            <%= f.number_field :display_order, value: (@asset_class_characteristics.maximum(:display_order) || 0) + 10, min: 0, style: "width: 80px" %>
          </div>
          <div class="form-group">
            <label style="display:flex;align-items:center;gap:0.35rem;padding-top:1.5rem;">
              <%= f.check_box :required %> Required
            </label>
          </div>
          <%= f.submit "Add", class: "btn btn-primary", style: "margin-top: 1.5rem" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="card">
  <div class="card-header">
    <h2>Assets using this Class (<%= @assets.count %>)</h2>
    <%= link_to "New Asset", new_asset_path(asset_class_id: @asset_class.id), class: "btn btn-primary btn-sm" %>
  </div>
  <% if @assets.any? %>
    <table>
      <thead>
        <tr><th>Tag</th><th>Name</th><th>Location</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% @assets.each do |asset| %>
          <tr>
            <td><%= link_to asset.asset_tag, asset_path(asset) %></td>
            <td><%= asset.name %></td>
            <td><%= asset.location.plant_name %></td>
            <td><%= status_badge(asset.status) %></td>
            <td><%= link_to "View", asset_path(asset), class: "btn btn-secondary btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">No assets with this class yet.</div>
  <% end %>
</div>
