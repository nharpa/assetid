<%# View: AssetClasses#edit — Form to edit an existing asset class %>
<% content_for :title, "Edit #{@asset_class.name} – AssetID" %>
<div class="page-header">
  <h1 class="page-title">Edit Asset Class</h1>
  <%= link_to "Cancel", @asset_class, class: "btn btn-secondary" %>
</div>
<div class="card"><div class="card-body">
  <%= form_with model: @asset_class do |f| %>
    <%= render "form", f: f, asset_class: @asset_class %>
  <% end %>
</div></div>
