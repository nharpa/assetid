<% content_for :title, "Edit #{@characteristic.name} – AssetID" %>
<div class="page-header">
  <h1 class="page-title">Edit Characteristic</h1>
  <%= link_to "Cancel", @characteristic, class: "btn btn-secondary" %>
</div>
<div class="card"><div class="card-body">
  <%= form_with model: @characteristic do |f| %>
    <%= render "form", f: f, characteristic: @characteristic %>
  <% end %>
</div></div>
