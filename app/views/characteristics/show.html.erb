<% content_for :title, "#{@characteristic.name} – AssetID" %>

<div class="page-header">
  <h1 class="page-title"><%= @characteristic.name %></h1>
  <div class="actions">
    <%= link_to "Edit",  edit_characteristic_path(@characteristic), class: "btn btn-secondary" %>
    <%= link_to "Back",  characteristics_path,                      class: "btn btn-secondary" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <div class="detail-label">Data Type</div>
        <div class="detail-value"><%= data_type_badge(@characteristic.data_type) %></div>
      </div>
      <div class="detail-item">
        <div class="detail-label">Unit</div>
        <div class="detail-value"><%= @characteristic.unit.presence || "—" %></div>
      </div>
      <div class="detail-item" style="grid-column: span 2">
        <div class="detail-label">Description</div>
        <div class="detail-value"><%= @characteristic.description.presence || "—" %></div>
      </div>
    </div>
  </div>
</div>

<% if @characteristic.data_type == "enum" %>
  <div class="card">
    <div class="card-header">
      <h2>Allowed Values (<%= @allowed_values.count %>)</h2>
    </div>

    <% if @allowed_values.any? %>
      <table>
        <thead>
          <tr>
            <th>Value</th>
            <% if current_user.admin? %><th></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% @allowed_values.each do |av| %>
            <tr>
              <td><%= av.value %></td>
              <% if current_user.admin? %>
                <td>
                  <%= button_to "Remove",
                        characteristic_characteristic_allowed_value_path(@characteristic, av),
                        method: :delete,
                        data: { turbo_confirm: "Remove '#{av.value}'?" },
                        class: "btn btn-danger btn-sm" %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state">No allowed values defined yet.</div>
    <% end %>

    <% if current_user.admin? %>
      <div class="card-body" style="border-top: 1px solid var(--border);">
        <div class="section-title">Add Allowed Value</div>
        <%= form_with model: [@characteristic, @new_allowed_value], local: true do |f| %>
          <div class="inline-form">
            <div class="form-group">
              <%= f.label :value, "Value" %>
              <%= f.text_field :value %>
            </div>
            <%= f.submit "Add", class: "btn btn-primary", style: "margin-top: 1.5rem" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="card">
  <div class="card-header">
    <h2>Used by Asset Classes</h2>
  </div>
  <% if @asset_classes.any? %>
    <table>
      <thead><tr><th>Class</th><th></th></tr></thead>
      <tbody>
        <% @asset_classes.each do |ac| %>
          <tr>
            <td><%= link_to ac.name, asset_class_path(ac) %></td>
            <td><%= link_to "View", asset_class_path(ac), class: "btn btn-secondary btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">Not assigned to any asset class yet.</div>
  <% end %>
</div>
