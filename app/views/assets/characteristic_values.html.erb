<%# View: Assets#characteristic_values — Bulk edit form for all characteristic values on an asset; renders the appropriate input type per data_type %>
<% content_for :title, "Characteristic Values – #{@asset.asset_tag} – AssetID" %>

<div class="breadcrumb">
  <%= link_to "Assets", assets_path %>
  <span class="breadcrumb-sep">›</span>
  <%= link_to @asset.asset_tag, asset_path(@asset) %>
  <span class="breadcrumb-sep">›</span>
  <span>Edit Characteristic Values</span>
</div>

<div class="page-header">
  <h1 class="page-title">Characteristic Values — <%= @asset.asset_tag %></h1>
  <%= link_to "Back to Asset", asset_path(@asset), class: "btn btn-secondary" %>
</div>

<div class="card">
  <div class="card-header">
    <h2><%= @asset.asset_class.name %> characteristics</h2>
  </div>

  <% if @accs.any? %>
    <%= form_with url: characteristic_values_asset_path(@asset), method: :patch, local: true do %>
      <div class="card-body">
        <% @accs.each do |acc| %>
          <div class="form-group">
            <label for="values_<%= acc.id %>">
              <%= acc.characteristic.name %>
              <% if acc.characteristic.unit.present? %>
                <span style="color: var(--text-muted); font-weight: normal;">(<%= acc.characteristic.unit %>)</span>
              <% end %>
              <% if acc.required? %>
                <span style="color: var(--danger);">*</span>
              <% end %>
            </label>

            <% existing = @acv_map[acc.id] %>

            <% if acc.characteristic.data_type == "enum" %>
              <select name="values[<%= acc.id %>]" id="values_<%= acc.id %>">
                <option value="">— not recorded —</option>
                <% acc.characteristic.characteristic_allowed_values.order(:value).each do |av| %>
                  <option value="<%= av.value %>" <%= "selected" if existing&.value == av.value %>>
                    <%= av.value %>
                  </option>
                <% end %>
              </select>
            <% elsif acc.characteristic.data_type == "boolean" %>
              <select name="values[<%= acc.id %>]" id="values_<%= acc.id %>">
                <option value="">— not recorded —</option>
                <option value="true"  <%= "selected" if existing&.value == "true"  %>>True</option>
                <option value="false" <%= "selected" if existing&.value == "false" %>>False</option>
              </select>
            <% elsif acc.characteristic.data_type == "date" %>
              <input type="date" name="values[<%= acc.id %>]" id="values_<%= acc.id %>" value="<%= existing&.value %>">
            <% elsif %w[integer decimal].include?(acc.characteristic.data_type) %>
              <input type="number" name="values[<%= acc.id %>]" id="values_<%= acc.id %>"
                     value="<%= existing&.value %>"
                     step="<%= acc.characteristic.data_type == 'decimal' ? '0.01' : '1' %>">
            <% else %>
              <input type="text" name="values[<%= acc.id %>]" id="values_<%= acc.id %>" value="<%= existing&.value %>">
            <% end %>

            <% if acc.characteristic.description.present? %>
              <p class="form-hint"><%= acc.characteristic.description %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="form-actions" style="padding: 1rem 1.25rem; border-top: 1px solid var(--border);">
        <input type="submit" value="Save Values" class="btn btn-primary">
        <%= link_to "Cancel", asset_path(@asset), class: "btn btn-secondary" %>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">
      No characteristics are defined for the <strong><%= @asset.asset_class.name %></strong> class.
      <%= link_to "Manage characteristics", asset_class_path(@asset.asset_class) %>.
    </div>
  <% end %>
</div>
