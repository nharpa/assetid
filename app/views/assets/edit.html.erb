<% content_for :title, "Edit #{@asset.asset_tag} – AssetID" %>
<div class="page-header">
  <h1 class="page-title">Edit Asset</h1>
  <%= link_to "Cancel", asset_path(@asset), class: "btn btn-secondary" %>
</div>
<div class="card"><div class="card-body">
  <%= form_with model: @asset do |f| %>
    <%= render "form", f: f, asset: @asset %>
  <% end %>
</div></div>
