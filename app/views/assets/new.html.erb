<%# View: Assets#new — Form to register a new asset %>
<% content_for :title, "New Asset – AssetID" %>
<div class="page-header"><h1 class="page-title">New Asset</h1></div>
<div class="card"><div class="card-body">
  <%= form_with model: @asset do |f| %>
    <%= render "form", f: f, asset: @asset %>
  <% end %>
</div></div>
